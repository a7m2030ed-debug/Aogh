{# Floating WhatsApp button — Theme Editor › Layout › Naseej #}
{% set wa_number = (settings.naseej_whatsapp | default('') | string).replace('+', '').replace(' ', '') %}
{% if wa_number and settings.naseej_whatsapp_float | default(true) %}
  <a
    class="nsj-wa"
    href="https://wa.me/{{ wa_number }}?text={{ settings.naseej_whatsapp_message | default('') | urlencode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ _('Chat with us on WhatsApp') }}"
  >
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7.1 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z" />
    </svg>
  </a>
{% endif %}
