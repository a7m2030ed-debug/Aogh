{% from 'components/naseej/macros.jinja' import drape_art, arrow %}
{% set is_lazy = (settings.order | default(3) | int) > 2 %}

{# Merchant tiles, or the three Naseej departments until some are added #}
{% set tiles = namespace(items=[]) %}
{% for item in settings.items or [] %}
  {% if item.title and item.title | trim %}
    {% set tiles.items = tiles.items + [item] %}
  {% endif %}
{% endfor %}
{% if tiles.items | length == 0 %}
  {% set tiles.items = [
    {'title': 'أقمشة صيفية', 'text': 'مصنّفة بالوقفة: طايح · ربع · نصف · واقف', 'tone': 'sand', 'button_text': 'تسوّق الصيفي'},
    {'title': 'أقمشة شتوية', 'text': 'صوف وكشمير مخلوط لليالي الباردة', 'tone': 'ink', 'button_text': 'تسوّق الشتوي'},
    {'title': 'طاقات للجملة', 'text': 'طاقات كاملة من 45 إلى 50 مترًا', 'tone': 'ivory', 'button_text': 'تسوّق الطاقات'}
  ] %}
{% endif %}

<section
  section-id="{{ sectionId }}"
  class="nsj-section"
>
  <div class="theme-container">
    {% with eyebrow=settings.eyebrow, title=settings.title, description=settings.description %}
      {% include 'components/naseej/section-head.jinja' %}
    {% endwith %}

    <div
      class="nsj-collections"
      style="--nsj-cols: {{ tiles.items | length }}"
    >
      {% for tile in tiles.items %}
        {% set tone = tile.tone or 'sand' %}
        <a
          href="{{ tile.url or url_for('list_categories') }}"
          class="nsj-tile {{ 'nsj-tile--image' if tile.image else 'nsj-tile--art nsj-tile--' ~ tone }} {{ 'nsj-tone-ink' if tone == 'ink' and not tile.image }}"
        >
          <div class="nsj-tile__media">
            {% if tile.image %}
              <img
                src="{{ image_url(tile.image, w=900, q=85, f='auto') }}"
                alt="{{ tile.title }}"
                {% if is_lazy or not loop.first %}loading="lazy"{% endif %}
              />
            {% else %}
              {{ drape_art(sectionId ~ '-t' ~ loop.index, tone) }}
            {% endif %}
          </div>
          <span class="nsj-tile__index">{{ '%02d' | format(loop.index) }}</span>
          <h3 class="nsj-tile__title">{{ tile.title }}</h3>
          {% if tile.text %}
            <p class="nsj-tile__text">{{ tile.text }}</p>
          {% endif %}
          <span class="nsj-tile__cta">
            {{ tile.button_text or _('Shop now') }}
            {{ arrow() }}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
