{% from 'components/malbousak/macros.jinja' import drape_art, arrow %}
{% set is_lazy = (settings.order | default(3) | int) > 2 %}

<section
  section-id="{{ sectionId }}"
  class="mlb-section"
>
  <div class="theme-container mlb-story {{ 'mlb-story--flip' if settings.flip }}">
    <div class="mlb-story__media">
      {% if settings.image %}
        <img
          src="{{ image_url(settings.image, w=1500, q=85, f='auto') }}"
          alt="{{ settings.title }}"
          {% if is_lazy %}loading="lazy"{% endif %}
        />
      {% else %}
        {{ drape_art(sectionId ~ '-art', settings.art_tone | default('sand')) }}
      {% endif %}
    </div>
    <div class="mlb-story__body">
      {% if settings.eyebrow %}
        <span class="mlb-eyebrow">{{ settings.eyebrow }}</span>
      {% endif %}
      {% if settings.title %}
        <h2 class="mlb-title">{{ settings.title }}</h2>
      {% endif %}
      {% if settings.text %}
        <p class="mlb-story__text">{{ settings.text }}</p>
      {% endif %}
      {% if settings.signature %}
        <p class="mlb-story__sign">{{ settings.signature }}</p>
      {% endif %}
      {% if settings.button_text and settings.button_text | trim %}
        <a
          href="{{ settings.button_url or url_for('list_products') }}"
          class="btn btn-outlined btn-lg mt-2"
        >
          {{ settings.button_text }}
          {{ arrow() }}
        </a>
      {% endif %}
    </div>
  </div>
</section>
