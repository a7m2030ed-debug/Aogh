{% from 'components/malbousak/macros.jinja' import arrow %}
{% set wa_number = (settings.whatsapp | default('') | string).replace('+', '').replace(' ', '') %}
{% set dark = (settings.tone | default('ink')) == 'ink' %}

{% set band = namespace(stats=[]) %}
{% for item in settings.stats or [] %}
  {% if item.value and item.value | trim %}
    {% set band.stats = band.stats + [item] %}
  {% endif %}
{% endfor %}
{% if band.stats | length == 0 %}
  {% set band.stats = [
    {'value': '45 – 50 م', 'label': 'طول الطاقة الواحدة'},
    {'value': '3+', 'label': 'طاقات لسعر الجملة'},
    {'value': 'كل المدن', 'label': 'شحن مرتّب للمحلات'}
  ] %}
{% endif %}

<section
  section-id="{{ sectionId }}"
  class="mlb-section mlb-band {{ 'mlb-tone-ink' if dark else 'mlb-weave' }}"
>
  <div class="theme-container mlb-band__inner">
    <div class="flex flex-col items-start gap-6">
      {% with eyebrow=settings.eyebrow, title=settings.title, description=settings.description, align='start' %}
        {% include 'components/malbousak/section-head.jinja' %}
      {% endwith %}
      <div class="flex flex-wrap gap-3">
        {% if settings.button_text and settings.button_text | trim %}
          <a
            href="{{ settings.button_url or url_for('list_products') }}"
            class="btn btn-lg px-7 {{ 'btn-gold' if dark else 'btn-filled' }}"
          >
            {{ settings.button_text }}
            {{ arrow() }}
          </a>
        {% endif %}
        {% if wa_number and settings.whatsapp_text %}
          <a
            href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | default('') | urlencode }}"
            target="_blank"
            rel="noopener"
            class="btn btn-lg px-7 {{ 'btn-on-dark' if dark else 'btn-outlined' }}"
          >
            {{ settings.whatsapp_text }}
          </a>
        {% endif %}
      </div>
    </div>
    <div class="mlb-stats">
      {% for stat in band.stats %}
        <div class="mlb-stat">
          <strong>{{ stat.value }}</strong>
          {% if stat.label %}<span>{{ stat.label }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
