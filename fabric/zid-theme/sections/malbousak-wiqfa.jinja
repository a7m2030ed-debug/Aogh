{% from 'components/malbousak/macros.jinja' import wiqfa_glyph, arrow %}

{# Merchant wiqfa types, or the four standard ones until some are added #}
{% set guide = namespace(items=[]) %}
{% for item in settings.items or [] %}
  {% if item.name and item.name | trim %}
    {% set guide.items = guide.items + [item] %}
  {% endif %}
{% endfor %}
{% if guide.items | length == 0 %}
  {% set guide.items = [
    {'name': 'الطايح', 'level': 1, 'description': 'أطرى الأقمشة وأكثرها انسيابية. يسقط على الجسم بلا قوام، مناسب للحر الشديد وللمجالس.'},
    {'name': 'ربع وقفة', 'level': 2, 'description': 'طري مع أثر خفيف من القوام. يحفظ شكل الثوب دون أن يبدو متيبسًا.'},
    {'name': 'نصف واقف', 'level': 3, 'featured': true, 'description': 'الوسط الذهبي وأكثر الأنواع طلبًا. قوام واضح مع راحة في اللبس طوال اليوم.'},
    {'name': 'واقف', 'level': 4, 'description': 'أقوى قوامًا. يعطي الثوب حِدّة في الكتف والصدر، ويُفضَّل للمناسبات والدوام الرسمي.'}
  ] %}
{% endif %}

<section
  section-id="{{ sectionId }}"
  {% if settings.anchor and settings.anchor | trim %}id="{{ settings.anchor | trim }}"{% endif %}
  class="mlb-section mlb-weave"
  style="scroll-margin-top: var(--header-h)"
>
  <div class="theme-container">
    {% with eyebrow=settings.eyebrow, title=settings.title, description=settings.description %}
      {% include 'components/malbousak/section-head.jinja' %}
    {% endwith %}

    <div class="mlb-wiqfa">
      {% for item in guide.items %}
        {% set level = (item.level or 2) | int %}
        {% set tag = 'a' if item.url else 'div' %}
        <{{ tag }}
          {% if item.url %}href="{{ item.url }}"{% endif %}
          class="mlb-wiqfa__card {{ 'is-featured' if item.featured }}"
        >
          {% if item.featured and settings.featured_label %}
            <span class="mlb-wiqfa__flag">{{ settings.featured_label }}</span>
          {% endif %}
          {{ wiqfa_glyph(level, 'mlb-wiqfa__glyph') }}
          <h3 class="mlb-wiqfa__name">{{ item.name }}</h3>
          <span
            class="mlb-stiff"
            data-level="{{ level }}"
            role="img"
            aria-label="{{ _('Stiffness %s of 4') | format(level) }}"
            ><i></i><i></i><i></i><i></i
          ></span>
          {% if item.description %}
            <p class="mlb-wiqfa__desc">{{ item.description }}</p>
          {% endif %}
          {% if item.url %}
            <span class="mlb-tile__cta text-foreground mt-auto">
              {{ _('Browse fabrics') }}
              {{ arrow() }}
            </span>
          {% endif %}
        </{{ tag }}>
      {% endfor %}
    </div>

    {% if settings.soft_label or settings.firm_label %}
      <div
        class="mlb-stiff-legend"
        aria-hidden="true"
      >
        <b class="font-normal">{{ settings.soft_label }}</b>
        <span></span>
        <b class="font-normal">{{ settings.firm_label }}</b>
      </div>
    {% endif %}
  </div>
</section>
