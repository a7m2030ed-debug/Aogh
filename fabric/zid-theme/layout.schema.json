    {
      "id": "malbousak",
      "icon": "fa fa-scissors",
      "name": {
        "ar": "هوية ملبوسك",
        "en": "Malbousak"
      },
      "settings": [
        {
          "id": "whatsapp",
          "type": "text",
          "label": {
            "ar": "رقم واتساب",
            "en": "WhatsApp number"
          },
          "info": {
            "ar": "بالصيغة الدولية بلا + ولا مسافات، مثل 966500000000",
            "en": "International format, digits only"
          },
          "default": ""
        },
        {
          "id": "whatsapp_message",
          "type": "text",
          "label": {
            "ar": "الرسالة الافتراضية",
            "en": "Default message"
          },
          "default": "السلام عليكم، أبي أستفسر عن الأقمشة"
        },
        {
          "id": "whatsapp_float",
          "type": "checkbox",
          "label": {
            "ar": "إظهار زر واتساب العائم",
            "en": "Show floating WhatsApp button"
          },
          "default": true
        },
        {
          "id": "meter_calculator",
          "type": "checkbox",
          "label": {
            "ar": "إظهار حاسبة «كم مترًا أحتاج؟» في صفحة المنتج",
            "en": "Show the meter calculator on product pages"
          },
          "default": true
        },
        {
          "id": "meter_rows",
          "type": "list",
          "label": {
            "ar": "جدول الأمتار حسب الطول",
            "en": "Meters by height"
          },
          "info": {
            "ar": "اتركه فارغًا لاستعمال الجدول المعتاد: حتى 165 سم = 3 م، 166–178 = 3.5 م، 179–188 = 4 م، أطول = 4.5 م",
            "en": "Leave empty for the standard table (3 / 3.5 / 4 / 4.5 m)"
          },
          "item_label": {
            "ar": "صف",
            "en": "Row"
          },
          "max_items": 6,
          "settings": [
            {
              "id": "label",
              "type": "text",
              "label": {
                "ar": "الطول",
                "en": "Height"
              }
            },
            {
              "id": "meters",
              "type": "text",
              "label": {
                "ar": "الأمتار لثوب واحد",
                "en": "Meters per thobe"
              }
            }
          ]
        },
        {
          "id": "wiqfa_guide_url",
          "type": "url",
          "label": {
            "ar": "رابط دليل الوقفة",
            "en": "Wiqfa guide link"
          },
          "info": {
            "ar": "يظهر تحت الحاسبة في صفحة المنتج. اتركه فارغًا لإخفائه",
            "en": "Shown under the calculator; leave empty to hide"
          },
          "default": ""
        },
        {
          "id": "product_notes",
          "type": "text",
          "label": {
            "ar": "مزايا قصيرة في صفحة المنتج",
            "en": "Short notes on product pages"
          },
          "info": {
            "ar": "افصل بينها بالرمز | واتركه فارغًا لإخفائها",
            "en": "Separate with |; empty hides them"
          },
          "default": "قصّ بالمتر حسب طلبك|شحن لكل مدن المملكة|دفع آمن"
        }
      ]
    },
    {
      "id": "gifting",
