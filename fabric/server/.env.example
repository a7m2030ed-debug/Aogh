# ======================================================================
#  انسخ هذا الملف إلى .env واملأه. لا ترفع .env إلى المستودع أبدًا.
# ======================================================================

NODE_ENV=development
PORT=3000

# عنوان المتجر كما يراه الزبون. في الإنتاج يجب أن يكون https،
# لأن بوابات الدفع ترفض الرجوع إلى http.
PUBLIC_URL=http://localhost:3000

# النطاقات المسموح لها بمناداة الواجهة (افصل بفاصلة).
# اتركه فارغًا إن كان المتجر يُخدَم من الخادم نفسه.
# ALLOWED_ORIGINS=https://example.com

# 1 إذا كان الخادم خلف بروكسي (Nginx أو Cloudflare)، ليُقرأ عنوان
# الزائر الحقيقي من X-Forwarded-For بدل عنوان البروكسي.
TRUST_PROXY=0

# مجلد البيانات. انسخه كاملًا للنسخ الاحتياطي.
DATA_DIR=data

# ---------------------------------------------------------------- الدفع
# demo | paytabs | myfatoorah | tap
# demo لا يحصّل شيئًا ويتعطّل تلقائيًا في وضع الإنتاج.
PAYMENT_PROVIDER=demo

# PAYTABS_PROFILE_ID=
# PAYTABS_SERVER_KEY=
# PAYTABS_ENDPOINT=https://secure.paytabs.sa

# MYFATOORAH_TOKEN=
# MYFATOORAH_WEBHOOK_SECRET=
# MYFATOORAH_ENDPOINT=https://api.myfatoorah.com

# TAP_SECRET_KEY=

# ---------------------------------------------------------------- الشحن
# manual | aramex | smsa
# manual يولّد رقم تتبّع داخليًا وتُدخل أنت رقم البوليصة الرسمي.
SHIPPING_PROVIDER=manual

# ARAMEX_USERNAME=
# ARAMEX_PASSWORD=
# ARAMEX_ACCOUNT_NUMBER=
# ARAMEX_ACCOUNT_PIN=
# ARAMEX_ENDPOINT=

# SMSA_USERNAME=
# SMSA_PASSWORD=
# SMSA_ACCOUNT_NUMBER=
# SMSA_ACCOUNT_PIN=
# SMSA_ENDPOINT=
