# =====================================================================
#  نظام إدارة الموظفين — متغيّرات البيئة
#  انسخ هذا الملف إلى .env واملأه. الملف .env مستثنى في .gitignore،
#  ولا يُكتب أي سرّ في الكود ولا يُرفع إلى المستودع.
# =====================================================================

# --- التشغيل ---------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# العنوان العام للنظام كما يفتحه المستخدم. يجب أن يكون https في الإنتاج،
# وإلا رفض الخادم الإقلاع (الكوكي لا يُحمى على http).
PUBLIC_URL=https://staff.company.com

# --- وضع الشبكة المحلية (بلا نطاق ولا استضافة) ------------------------
# اجعله 1 حين يعمل النظام على جهاز داخل المجمع ويفتحه الموظفون من نفس
# الشبكة. حينها يُسمح بـhttp ويُطبع تنبيه عند كل تشغيل، ولا يلزم
# PUBLIC_URL أصلًا. لا تستعمله مع جهاز مفتوح على الإنترنت.
LAN=0

# شهادة محلية اختيارية تجعل حتى الشبكة الداخلية مشفَّرة:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
#     -keyout local-key.pem -out local-cert.pem -subj "/CN=staff"
# TLS_CERT=local-cert.pem
# TLS_KEY=local-key.pem

# --- البيانات --------------------------------------------------------
# قاعدة البيانات والمرفقات. في الحاوية اجعله حجمًا منفصلًا (/data).
DATA_DIR=data

# مجلد النسخ الاحتياطية. اجعله على قرص/حجم آخر غير DATA_DIR،
# فنسخة احتياطية بجانب الأصل تضيع معه.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# ساعة النسخ اليومي (0–23) بتوقيت الخادم. اجعلها -1 لإيقاف النسخ التلقائي.
BACKUP_HOUR=2

# --- الأمن -----------------------------------------------------------
# انتهاء الجلسة بالخمول، والحد الأقصى لعمر الجلسة مهما كانت نشطة.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# 1 حين يعمل النظام خلف وسيط (nginx / Cloudflare) لقراءة X-Forwarded-For.
TRUST_PROXY=1
# اتركه فارغًا ليساوي PUBLIC_URL. يُستعمل حين تُستضاف الواجهة على نطاق آخر.
ALLOWED_ORIGINS=
# حد حجم المرفق الواحد بالميغابايت.
MAX_UPLOAD_MB=10

# --- الحساب الأول ----------------------------------------------------
# يُنشأ عند أول تشغيل فقط. إن تُركت كلمة المرور فارغة وُلِّدت كلمة عشوائية
# وطُبعت مرة واحدة في سجل الخادم، ويُطلب تغييرها عند أول دخول.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام
