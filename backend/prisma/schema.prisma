// Database design for "قطعتي" — a request-and-connect platform for used
// car parts.
//
// The model is deliberately narrow (client decision, 2026-09-05): a
// customer posts what part they need for which car, every dealer is
// notified, and any dealer who has it opens a conversation. The platform
// introduces the two sides and stays out of everything after that — no
// dealer inventory, no catalog browsing, no orders, no delivery, no
// ratings. Those tables existed in an earlier marketplace design and were
// removed with this pivot; they're recoverable from git history if the
// scope ever widens again.
//
// Grouped by architectural module (see docs/architecture.md, section
// 7.1/7.2 of the technical review). Each module "owns" its tables;
// cross-module reads should go through a service call or the event bus,
// not a direct join into another module's table, so a module can be split
// into its own service later without a schema rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity: customers, dealers ─────────────────────────────────────────

enum UserRole {
  CUSTOMER
  DEALER_OWNER
  DEALER_STAFF
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  city         String?
  lastLat      Float?
  lastLng      Float?
  pushToken    String?  // FCM registration token — see modules/notifications/push
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealerProfile Dealer?        @relation("DealerOwner")
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]      @relation("UserMessages")
  notifications Notification[]
  partRequests  PartRequest[]

  @@map("users")
}

enum DealerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Dealer {
  id                   String                   @id @default(uuid())
  ownerUserId          String                   @unique
  owner                User                     @relation("DealerOwner", fields: [ownerUserId], references: [id])
  businessName         String
  activityType         String
  commercialRegistryNo String?
  municipalLicenseNo   String?
  contactName          String
  contactPhone         String
  city                 String
  lat                  Float?
  lng                  Float?
  verificationStatus   DealerVerificationStatus @default(PENDING)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  documents     DealerDocument[]
  conversations Conversation[]   @relation("DealerConversations")
  notifications Notification[]

  // Every new request fans out to "all VERIFIED dealers" — the one query
  // that runs on the app's hottest path.
  @@index([verificationStatus])
  @@map("dealers")
}

enum DealerDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model DealerDocument {
  id        String               @id @default(uuid())
  dealerId  String
  dealer    Dealer               @relation(fields: [dealerId], references: [id])
  type      String
  fileUrl   String
  status    DealerDocumentStatus @default(PENDING)
  createdAt DateTime             @default(now())

  @@map("dealer_documents")
}

// ── Catalog ──────────────────────────────────────────────────────────────
// Read-only reference data that feeds the three fields on the request
// form: the parts dictionary powers the part-name suggestions, and
// makes/models fill the two dropdowns. Nothing writes to these at runtime;
// they're loaded by prisma/seed.ts.

model VehicleMake {
  id     String         @id @default(uuid())
  nameAr String
  nameEn String
  models VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id     String        @id @default(uuid())
  makeId String
  make   VehicleMake   @relation(fields: [makeId], references: [id])
  nameAr String
  nameEn String
  trims  VehicleTrim[]

  @@unique([makeId, nameEn])
  @@map("vehicle_models")
}

model VehicleTrim {
  id       String       @id @default(uuid())
  modelId  String
  model    VehicleModel @relation(fields: [modelId], references: [id])
  yearFrom Int
  yearTo   Int
  nameAr   String?
  nameEn   String?

  @@map("vehicle_trims")
}

model PartCategory {
  id       String          @id @default(uuid())
  parentId String?
  parent   PartCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children PartCategory[]  @relation("CategoryTree")
  nameAr   String
  nameEn   String
  parts    CanonicalPart[]

  @@map("part_categories")
}

model CanonicalPart {
  id              String       @id @default(uuid())
  categoryId      String
  category        PartCategory @relation(fields: [categoryId], references: [id])
  canonicalNameAr String
  canonicalNameEn String
  synonyms        String[]     @default([])
  oemNumbers      String[]     @default([])
  createdAt       DateTime     @default(now())

  @@map("canonical_parts")
}

// ── Requests ─────────────────────────────────────────────────────────────
// The whole customer-facing product: three fields and an optional photo.
// partName/vehicleMake/vehicleModel are stored as the text the customer
// submitted rather than as foreign keys — the app sources them from the
// catalog above, but a request must survive a catalog row being renamed or
// removed, and the part name is free text with suggestions, not a picker.

enum PartRequestStatus {
  OPEN
  CLOSED
}

model PartRequest {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  partName     String
  vehicleMake  String
  vehicleModel String
  photoUrl     String?
  status       PartRequestStatus @default(OPEN)
  createdAt    DateTime          @default(now())

  conversations Conversation[]

  // Every list query in the app gets an index covering both its filter
  // and its sort, so neither degrades into a scan-and-sort as rows pile
  // up: the dealer feed reads open requests newest-first, and "طلباتي"
  // reads one customer's newest-first.
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("part_requests")
}

// ── Conversations ────────────────────────────────────────────────────────
// A conversation exists only because a dealer answered a request. Several
// dealers may answer the same one, giving the customer a thread per dealer.

model Conversation {
  id            String      @id @default(uuid())
  partRequestId String
  partRequest   PartRequest @relation(fields: [partRequestId], references: [id])
  userId        String
  user          User        @relation("UserConversations", fields: [userId], references: [id])
  dealerId      String
  dealer        Dealer      @relation("DealerConversations", fields: [dealerId], references: [id])
  createdAt     DateTime    @default(now())

  messages Message[]

  // A dealer answers a given request once; answering again reopens the
  // thread they already have rather than starting a second one. (This
  // also indexes partRequestId on its own, which is how a request's
  // answers are loaded.)
  @@unique([partRequestId, dealerId])
  // The two conversation lists — customer side and dealer side.
  @@index([userId, createdAt])
  @@index([dealerId, createdAt])
  @@map("conversations")
}

enum MessageSenderType {
  USER
  DEALER
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  senderType     MessageSenderType
  senderUserId   String?
  senderUser     User?             @relation("UserMessages", fields: [senderUserId], references: [id])
  text           String?
  imageUrl       String?
  videoUrl       String?
  locationLat    Float?
  locationLng    Float?
  createdAt      DateTime          @default(now())

  // Serves both reading a thread in order and pulling just its latest
  // message for the conversation-list preview.
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  dealerId  String?
  dealer    Dealer?   @relation(fields: [dealerId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // A notification is addressed to exactly one of these, and the bell
  // reads whichever applies, newest first.
  @@index([userId, createdAt])
  @@index([dealerId, createdAt])
  @@map("notifications")
}

// ── Admin & audit ─────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
}

model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      AdminRole @default(SUPPORT)
  createdAt DateTime  @default(now())

  auditEntries AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@map("audit_log")
}
