# Copy to .env and fill in real values before running against anything but
# local dev. Every external service here is listed in the technical review,
# section 7.6 — none are wired to a real provider yet in this skeleton.

PORT=3000
DATABASE_URL="postgresql://carparts:carparts@localhost:5432/carparts?schema=public"

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# SMS/OTP gateway — used ONLY for the login/registration code (spec
# section 4), never for order/chat/other notifications (those are push,
# below). "mock" keeps the fixed dev OTP in auth.service.ts; set to a real
# provider name once one is chosen.
OTP_PROVIDER=mock

# No maps/geocoding provider by client decision. Distance search and the
# delivery-fee calculator still work off plain lat/lng numbers — the
# mobile app should read those from the device's own location permission
# (e.g. the `geolocator` package), not a paid Maps SDK.

# Push notifications (spec section 32, review 7.6)
PUSH_PROVIDER=fcm
PUSH_CREDENTIALS_PATH=

# Media storage — part photos/videos, dealer documents (spec "Storage").
# Confirmed still needed even with the "AI just confirms, dealer publishes"
# flow: the photo has to outlive the AI call so customers can see it later.
# Any S3-compatible provider works (e.g. Cloudflare R2 — cheap, no egress
# fees, works unchanged with this config). STORAGE_ENDPOINT is where the
# app uploads to; STORAGE_PUBLIC_BASE_URL is what image URLs are built
# from afterward (often a different host — a CDN/public bucket domain).
STORAGE_PROVIDER=s3-compatible
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI vision for part recognition (spec section 9, review 7.4). "mock" uses
# MockVisionProvider — see src/modules/ai/providers/mock-vision.provider.ts
AI_VISION_PROVIDER=mock
AI_VISION_API_KEY=
