# Copy to .env and fill in real values before running against anything but
# local dev. Every external service here is listed in the technical review,
# section 7.6 — none are wired to a real provider yet in this skeleton.

PORT=3000
DATABASE_URL="postgresql://carparts:carparts@localhost:5432/carparts?schema=public"

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# SMS/OTP gateway — used ONLY for the login/registration code (spec
# section 4), never for order/chat/other notifications (those are push,
# below). "mock" keeps the fixed dev OTP in auth.service.ts (code "0000").
#
# Two real options, same interface — one .env line switches between them:
#
# OTP_PROVIDER=taqnyat — Taqnyat (تقنيات), a Saudi gateway. Recommended
#   for launching in KSA: A2P SMS to +966 numbers needs a sender name
#   registered with the local regulator, and the Saudi gateways handle
#   that registration during onboarding. Sign up at https://taqnyat.sa,
#   create a sender name, then take the API token from the dashboard.
OTP_PROVIDER=mock
TAQNYAT_TOKEN=
TAQNYAT_SENDER=

# OTP_PROVIDER=twilio — the international option. Create an account at
#   https://www.twilio.com/try-twilio, provision a sender number that can
#   deliver to Saudi numbers, then copy the values from the Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# No maps/geocoding provider by client decision. Distance search and the
# delivery-fee calculator still work off plain lat/lng numbers — the
# mobile app should read those from the device's own location permission
# (e.g. the `geolocator` package), not a paid Maps SDK.

# Push notifications (spec section 32, review 7.6). "none" ships an
# in-app-only NotificationsService — no device wake-up, just the bell
# icon list. Set to "fcm" for real push — create a Firebase project
# (https://console.firebase.google.com), add an Android/iOS app to it,
# then generate a service-account key (Project settings → Service
# accounts → Generate new private key) and fill in the three values
# below from that downloaded JSON. See
# src/modules/notifications/push/providers/fcm-push.provider.ts and
# mobile/README.md for the client-side half (firebase_messaging setup).
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Media storage — the optional photo a customer attaches to a request,
# images sent in chat, and dealer verification documents. Any S3-compatible
# provider works (e.g. Cloudflare R2 — cheap, no egress fees, works
# unchanged with this config). STORAGE_ENDPOINT is where the app uploads
# to; STORAGE_PUBLIC_BASE_URL is what image URLs are built from afterward
# (often a different host — a CDN/public bucket domain).
STORAGE_PROVIDER=s3-compatible
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
